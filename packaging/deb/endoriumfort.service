[Unit]
Description=EndoriumFort PAM Bastion (Community Edition backend)
Documentation=https://github.com/Endorium-Group/EndoriumFort-CE
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=endoriumfort
Group=endoriumfort
WorkingDirectory=/var/lib/endoriumfort
# File share resources: signs drive tickets and purge orders for the
# endoriumfort-files service (key 0640 root:endoriumfort-fskey).
SupplementaryGroups=endoriumfort-fskey
Environment=ENDORIUMFORT_FILESHARE_SECRET_FILE=/etc/endoriumfort/fileshare.key
Environment=ENDORIUMFORT_FILESHARE_UPSTREAM=http://127.0.0.1:8090
EnvironmentFile=-/etc/endoriumfort/endoriumfort.env
ExecStart=/opt/endoriumfort/bin/endoriumfort_backend
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/endoriumfort
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
